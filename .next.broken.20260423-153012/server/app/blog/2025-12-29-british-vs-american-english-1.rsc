음식"}]}],["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":"crisps"}],["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":"chips"}],["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":["\"I brought a bag of salt and vinegar ",["$","strong","strong-0",{"children":"crisps"}],".\""]}]]}]]}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"만약 영국 튜터에게 \"I love eating chips.\"라고 말한다면, 튜터는 감자튀김이 아닌 봉지에 든 포테이토칩을 좋아한다고 이해할 것입니다. 이처럼 어휘의 작은 차이가 때로는 큰 오해를 불러일으킬 수 있습니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"실제 적용 팁:"}]," 튜터가 어떤 영어를 사용하는지 파악했다면, 그들이 사용하는 어휘를 따라 해보세요. 예를 들어, 영국 튜터와 대화할 때는 엘리베이터 대신 ",["$","strong","strong-1",{"children":"lift"}],"를 사용하려고 노력하는 것이 좋습니다."]}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","em","em-0",{"children":"예시:"}]," \"The ",["$","strong","strong-0",{"children":"lift"}]," in my building is constantly out of service.\" (BrE)"]}],"\n"]}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"눈에 띄는 철자법과 날짜 표기"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2025-12-29-british-vs-american-english-1-h2-3.jpg","alt":"눈에 띄는 철자법과 날짜 표기","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"눈에 띄는 철자법과 날짜 표기"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"쓰기 영역, 특히 이메일이나 채팅을 할 때 철자법 차이는 즉각적으로 드러납니다. 영국식 영어는 전통적인 라틴어 및 프랑스어 철자법의 영향을 많이 받았기 때문에, 미국식 영어보다 더 복잡한 형태를 유지하는 경우가 많습니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"가장 흔한 세 가지 철자법 차이입니다."}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"1. -or vs. -our"}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["BrE는 ",["$","strong","strong-0",{"children":"-our"}],"를 사용합니다: colour, favourite, labour"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["AmE는 ",["$","strong","strong-0",{"children":"-or"}],"를 사용합니다: color, favorite, labor\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","em","em-0",{"children":"예시:"}]," \"What is your ",["$","strong","strong-0",{"children":"favourite"}]," ",["$","strong","strong-1",{"children":"colour"}],"?\" (BrE)"]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"2. -ise vs. -ize"}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["BrE는 주로 ",["$","strong","strong-0",{"children":"-ise"}],"를 사용합니다 (하지만 옥스퍼드 사전 등 일부 기관은 -ize를 허용하기도 합니다): organise, realise"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["AmE는 ",["$","strong","strong-0",{"children":"-ize"}],"를 사용합니다: organize, realize\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","em","em-0",{"children":"예시:"}]," \"We need to ",["$","strong","strong-0",{"children":"organise"}]," the schedule for next month.\" (BrE)"]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"3. -re vs. -er"}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["BrE는 ",["$","strong","strong-0",{"children":"-re"}],"를 사용합니다: centre, theatre"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["AmE는 ",["$","strong","strong-0",{"children":"-er"}],"를 사용합니다: center, theater\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","em","em-0",{"children":"예시:"}]," \"The new movie is playing at the ",["$","strong","strong-0",{"children":"theatre"}]," downtown.\" (BrE)"]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"날짜 표기법의 위험"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"철자법보다 더 중요하고 혼란스러울 수 있는 것은 날짜 표기법입니다. 이 차이를 모른다면 중요한 약속을 놓칠 수도 있습니다."}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"BrE:"}]," 일/월/년 (DD/MM/YYYY) 순서로 표기합니다."]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"AmE:"}]," 월/일/년 (MM/DD/YYYY) 순서로 표기합니다."]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"만약 여러분이 튜터에게 \"I have a flight on 04/05/2026.\"이라고 보냈다면, 영국 튜터는 5월 4일로 이해하겠지만 미국 튜터는 4월 5일로 이해하여 심각한 혼선이 발생할 수 있습니다. 날짜를 말할 때는 헷갈림을 방지하기 위해 반드시 월 이름을 풀어서 쓰는 것이 가장 좋습니다."}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","em","em-0",{"children":"권장 예시:"}]," \"I have a flight on ",["$","strong","strong-0",{"children":"May 4th"}],", 2026.\""]}],"\n"]}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"동기 부여 인용구와 학습 전략"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2025-12-29-british-vs-american-english-1-h2-4.jpg","alt":"동기 부여 인용구와 학습 전략","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"동기 부여 인용구와 학습 전략"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"영국 영어와 미국 영어의 차이점을 배우는 것이 처음에는 부담스러울 수 있습니다. 하지만 이 모든 차이는 영어라는 언어의 풍부함과 다양성을 보여줍니다. 중요한 것은 완벽함이 아니라 명확한 의사소통입니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["언어학자 노암 촘스키는 이렇게 말했습니다. ",["$","strong","strong-0",{"children":"\"언어는 사고와 표현을 가능하게 하는 놀라운 도구이다.\""}]," 우리가 어떤 영어를 배우든, 이 도구를 잘 활용하여 우리의 생각을 명확하게 전달하는 것이 목표가 되어야 합니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"YES 화상영어 학습자들이 두 영어 환경에서 혼란 없이 성장할 수 있는 실용적인 전략 세 가지를 제시합니다."}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"1. 일관성을 유지하라 (Choose Your Path)"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["YES 수업을 들을 때 튜터가 사용하는 영어가 영국식인지 미국식인지 확인했다면, 당분간은 그 스타일에 맞춰 말하고 쓰는 연습을 해보세요. 두 스타일을 섞어 쓰는 것(예: 영국식 ",["$","em","em-0",{"children":"flat"}],"과 미국식 ",["$","em","em-1",{"children":"color"}],"를 함께 사용하는 것)은 혼란을 가중시킬 수 있습니다. 한쪽 스타일에 익숙해진 후 다른 스타일의 특징을 덧붙이는 것이 효과적입니다."]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"2. 실생활에 바로 적용되는 예문 학습"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"억양 차이를 극복하기 위해 프렌즈(AmE)나 셜록(BrE) 같은 미디어를 보듯, 어휘 차이를 극복하기 위해서는 항상 완전한 문장으로 연습해야 합니다. 템플릿 문장이 아닌 구체적인 경험을 문법에 맞춰 활용하세요."}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","em","em-0",{"children":"연습 예시:"}]," \"The traffic was so heavy that I almost missed the train to the ",["$","strong","strong-0",{"children":"city centre"}],".\" (BrE 환경에서 Centre 사용)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","em","em-0",{"children":"연습 예시:"}]," \"I need to get some ",["$","strong","strong-0",{"children":"petrol"}]," before we leave for our ",["$","strong","strong-1",{"children":"holiday"}],".\" (BrE 어휘 Petrol과 Holiday 사용)"]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"3. 튜터에게 피드백을 요청하라"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["화상영어의 가장 큰 장점은 즉각적인 피드백입니다. 대화 중 여러분이 잘못된 맥락에서 어휘를 사용하거나 (예: 감자튀김을 의미할 때 ",["$","em","em-0",{"children":"chips"}]," 대신 ",["$","em","em-1",{"children":"french fries"}],"를 사용하여) 문법 실수를 했을 때, 튜터에게 해당 표현이 그들의 스타일에 맞는지 물어보세요."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"\"Is 'trunk' the common word you use for a car boot?\" 와 같이 질문하여 문화적, 언어적 차이를 이해하는 대화로 발전시킬 수 있습니다."}],"\n",["$","hr","hr-0",{}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"영국 영어와 미국 영어는 마치 한 가족의 두 형제 같습니다. DNA는 공유하지만, 성장 환경과 사용하는 방식이 조금 다를 뿐이죠. 여러분이 어느 쪽 영어를 배우든지, 언어 학습에서 가장 중요한 것은 자신감과 지속적인 노력입니다. YES와 함께 여러분의 영어 학습 목표를 성공적으로 달성하시기를 응원합니다!"}]]}]}]}],["$","$L4",null,{"posts":[{"slug":"2026-03-25-literature-cultural-understanding-1","title":"문학 작품으로 배우는 진짜 영어와 영미 문화의 깊은 매력","subtitle":"YES와 함께라면 영미 문학도 이제는 두렵지 않은 즐거운 여행이 됩니다","date":"$D2026-03-25T03:35:35.498Z","featuredImage":"/images/blog/2026-03-25-literature-cultural-understanding-1.jpg","excerpt":"영어를 공부하면서 단어와 문법만으로는 채워지지 않는 갈증을 느끼셨나요. 영미 문학 작품 속에 숨겨진 문화적 맥락을 이해하면 여러분의 영어 실력은 한 단계 더 도약할 수 있습니다."},{"slug":"2026-02-25-past-perfect-continuous-1","title":"영어 실력을 풍성하게 만드는 과거완료와 과거완료진행 레시피 가이드","subtitle":"복잡한 시제 고민을 한 번에 해결해주는 완벽한 문법 요리법을 소개합니다","date":"$D2026-02-25T03:34:23.805Z","featuredImage":"/images/blog/2026-02-25-past-perfect-continuous-1.jpg","excerpt":"과거완료와 과거완료진행은 영어 회화에서 시간의 흐름을 더 정교하게 표현하는 마법 같은 도구입니다. 복잡해 보이는 문법을 맛있는 요리 레시피처럼 단계별로 정리하여 YES 학생 여러분이 쉽게 익힐 수 있도록 준비했습니다."},{"slug":"2026-02-26-negotiation-english-business-1","title":"비즈니스 협상에서 침묵의 힘을 깨닫고 영어 자신감을 얻은 비결","subtitle":"거절이 두려웠던 직장인이 협상의 주도권을 잡게 된 결정적인 순간과 실전 전략","date":"$D2026-02-26T03:31:14.942Z","featuredImage":"/images/blog/2026-02-26-negotiation-english-business-1.jpg","excerpt":"비즈니스 협상은 단순히 영어를 잘하는 것을 넘어 상대의 심리를 읽고 전략적으로 접근하는 과정입니다. 거절이 두려워 늘 손해만 보던 제가 YES 화상영어를 통해 배운 실전 협상 팁과 개인적인 돌파구의 순간들을 모두 공개합니다."}]}]]}]],null],null],null]},[[null,[["$","$L5",null,{"id":"article-structured-data-2025-12-29-british-vs-american-english-1","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"{{title}}