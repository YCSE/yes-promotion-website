어요","fill":true,"className":"object-cover shadow-none","priority":true,"sizes":"(max-width: 768px) 100vw, 900px"}]}]}]}],["$","div",null,{"className":"page-shell py-[40px] md:py-[80px]","children":["$","div",null,{"className":"max-w-[900px] mx-auto","children":["$","article",null,{"className":"blog-content prose prose-lg max-w-none","children":[["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"안녕하세요, YES 학생 여러분! 에디터 오혜리입니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"화상영어 수업을 진행하며 문법에 대한 질문을 받을 때, 늘 상위권에 랭크되는 주제가 있습니다. 바로 '완료 시제'입니다. 현재완료(Present Perfect)도 어렵지만, 과거완료(Past Perfect)와 과거완료진행형(Past Perfect Continuous)은 한국어에 정확히 대응하는 개념이 없어 더욱 혼란스럽게 느껴지곤 합니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["흔히 과거완료를 '대과거'라고만 외우고 넘어가지만, 이 접근법은 사실 영어 학습에 방해가 될 수 있습니다. 단순히 ‘더 오래된 과거’라는 개념을 넘어, 이 시제들이 ",["$","strong","strong-0",{"children":"두 과거 사건 사이의 관계"}],"를 어떻게 설명하는지 이해하는 것이 중요합니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"오늘은 과거완료와 과거완료진행형이 실제로 어떤 뉘앙스를 전달하며, 왜 단순 과거 시제 대신 이 복잡한 시제를 사용해야 하는지에 대해 알아보겠습니다."}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"과거완료 (Past Perfect) 그것이 알고 싶다"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2026-01-27-past-perfect-continuous-1-h2-1.jpg","alt":"과거완료 (Past Perfect) 그것이 알고 싶다","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"과거완료 (Past Perfect) 그것이 알고 싶다"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["과거완료 시제는 ",["$","strong","strong-0",{"children":"'had + 과거분사(P.P.)'"}]," 형태로, 과거의 특정 시점보다 ",["$","em","em-0",{"children":"먼저"}]," 일어난 행동이나 상태를 설명할 때 사용됩니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"핵심은 문장 안에 최소 두 가지의 과거 사건이 존재해야 한다는 점입니다. 이 두 사건 중 더 먼저 일어난 일을 과거완료로 표현함으로써 시간의 선후 관계를 명확히 해주는 역할을 합니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"이 시제가 필요한 이유는, 우리가 문장을 말하거나 글을 쓸 때 시간 순서대로 모든 것을 나열하지 않기 때문입니다. 독자나 청자가 현재 이야기하고 있는 과거 시점(기준점)보다 이전에 어떤 일이 벌어졌는지 알게 해주는 일종의 '시간 여행 장치'라고 생각해보세요."}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":["$","strong","strong-0",{"children":"실제 상황 예문:"}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"Imagine this: 퇴근 후 집에 도착했는데, 현관문이 잠겨 있지 않습니다."}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["When I got home, I realized my brother ",["$","strong","strong-0",{"children":"had forgotten"}]," to lock the door.\r\n(내가 집에 도착한 시점보다, 동생이 문을 잠그는 것을 잊어버린 시점이 더 먼저이다.)"]}],"\n"]}],"\n"]}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","start":2,"children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["The office meeting started late because the CEO ",["$","strong","strong-0",{"children":"had missed"}]," his flight.\r\n(회의가 늦게 시작된 과거 시점보다, CEO가 비행기를 놓친 시점이 더 먼저 발생했다는 것이 원인 관계와 함께 명확해진다.)"]}],"\n"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["여기서 'had forgotten'과 'had missed'는 기준이 되는 과거 사건(got home, started late)의 ",["$","strong","strong-0",{"children":"이유"}],"나 ",["$","strong","strong-1",{"children":"배경"}],"을 설명해주는 역할을 합니다."]}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"'대과거'라는 오해에 도전하기"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2026-01-27-past-perfect-continuous-1-h2-2.jpg","alt":"'대과거'라는 오해에 도전하기","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"'대과거'라는 오해에 도전하기"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"많은 학습자들이 과거완료를 무조건 '단순 과거보다 더 오래된 과거'라고 생각하지만, 사실 단순히 두 사건이 시간상 순서대로 나열될 때는 과거완료를 쓸 필요가 없습니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"오해 챌린지:"}]," ",["$","strong","strong-1",{"children":"순서가 명확하다면 단순 과거 시제를 사용해도 충분합니다."}]]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"예를 들어, 아침에 일어나서 이메일을 확인한 순서대로 말한다면?"}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["I ",["$","strong","strong-0",{"children":"woke up"}],", ",["$","strong","strong-1",{"children":"checked"}]," my phone, and ",["$","strong","strong-2",{"children":"read"}]," the important email. (O)"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"이 문장은 세 가지 과거 사건이 시간 순서대로 발생했음을 명확히 보여줍니다. 굳이 \"I had woken up\"이라고 할 필요가 없습니다."}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":["$","strong","strong-0",{"children":"과거완료가 필요한 결정적인 순간:"}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["과거완료는 문장의 순서가 실제 사건 발생 순서와 다를 때, 또는 어떤 과거 사건이 ",["$","strong","strong-0",{"children":"다른 과거 사건의 원인 또는 배경"}],"이 될 때 필수적으로 사용됩니다. 즉, 정보의 전달을 명확하게 하기 위해서입니다."]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":["$","strong","strong-0",{"children":"실제 상황 예문:"}]}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["We finally saw the new bridge that the city ",["$","strong","strong-0",{"children":"had built"}]," last year.\r\n(우리가 다리를 본 과거 시점보다, 다리를 지은 시점이 더 앞선다. 문장 구성상 '다리를 본 것'을 먼저 말하고 있지만, 과거완료를 통해 실제 건축이 먼저 일어났음을 보여준다.)"]}],"\n"]}],"\n"]}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","start":2,"children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["I was worried because I ",["$","strong","strong-0",{"children":"had never driven"}]," a manual car until I rented one in Europe.\r\n(유럽에서 차를 렌트한 과거 시점까지, 그 이전에 수동차를 운전해 본 경험이 없었음(경험의 부재)을 설명한다.)"]}],"\n"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["과거완료는 단순히 '옛날 일'을 말하는 것이 아니라, ",["$","strong","strong-0",{"children":"'어떤 과거 시점까지의 완료, 경험, 결과'"}],"를 압축적으로 보여주는 도구입니다."]}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"과거완료진행형 (Past Perfect Continuous) 뉘앙스 파악하기"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2026-01-27-past-perfect-continuous-1-h2-3.jpg","alt":"과거완료진행형 (Past Perfect Continuous) 뉘앙스 파악하기","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"과거완료진행형 (Past Perfect Continuous) 뉘앙스 파악하기"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["이제 조금 더 복잡한 시제인 과거완료진행형을 살펴보겠습니다. 이 시제는 ",["$","strong","strong-0",{"children":"'had been + 동사원형-ing'"}]," 형태로 사용됩니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["과거완료진행형은 과거의 특정 시점까지 ",["$","strong","strong-0",{"children":"얼마나 오랫동안"}]," 어떤 행동이 계속되었는지를 강조할 때 사용됩니다. 즉, 이 시제의 핵심은 ",["$","strong","strong-1",{"children":"'지속된 기간(Duration)'"}],"입니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"주로 다음과 같은 뉘앙스를 전달합니다:"}],"\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"지속된 행위:"}]," 과거의 특정 시점까지 멈추지 않고 계속된 활동을 묘사."]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"과거 결과의 원인:"}]," 과거의 어떤 결과(피곤함, 더러움, 화남 등)가 왜 발생했는지, 그 직전까지 지속된 행위를 통해 설명."]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":["$","strong","strong-0",{"children":"실제 상황 예문:"}]}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["Her eyes were red because she ",["$","strong","strong-0",{"children":"had been crying"}]," all night before the meeting started.\r\n(회의가 시작된 과거 시점까지, 그녀가 밤새도록 울고 있었다는 '지속된 행위'와 그로 인한 '결과'(눈이 빨갛다는 상태)를 설명한다.)"]}],"\n"]}],"\n"]}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","start":2,"children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["The ground was wet. It ",["$","strong","strong-0",{"children":"had been raining"}]," heavily for two hours when we left the house.\r\n(우리가 집을 나선 과거 시점까지, 비가 2시간 동안 '계속 내리고 있었다'는 지속 기간을 강조한다.)"]}],"\n"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["만약 위 예문에서 과거완료(had rained)를 사용하면, 비가 내리는 행위 자체가 과거 시점 이전에 ",["$","em","em-0",{"children":"완료"}],"되었음을 뜻하지만, 완료진행형(had been raining)은 그 행동의 ",["$","em","em-1",{"children":"지속성"}],"을 강조하여 '땅이 젖어있는 상태'에 대한 직접적인 원인을 설명해줍니다."]}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"완료와 완료진행, 선택의 기준"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2026-01-27-past-perfect-continuous-1-h2-4.jpg","alt":"완료와 완료진행, 선택의 기준","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"완료와 완료진행, 선택의 기준"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"과거완료와 과거완료진행형 모두 과거의 기준점보다 먼저 일어난 일을 설명하지만, 선택의 기준은 명확합니다."}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",["$","div",null,{"className":"my-6 w-full overflow-y-auto rounded-[10px] border border-gray-200","children":["$","table",null,{"className":"w-full","children":[["$","thead",null,{"className":"bg-gray-50 border-b border-gray-200","children":["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"구분"}],["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"과거완료 (Past Perfect)"}],["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"과거완료진행형 (Past Perfect Continuous)"}]]}]}],["$","tbody",null,{"className":"divide-y divide-gray-100","children":[["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlig