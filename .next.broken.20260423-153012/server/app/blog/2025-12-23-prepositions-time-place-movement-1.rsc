] font-mono text-sm font-semibold text-pink-600","children":"at"}],"을 써야 할지, ",["$","code",null,{"lang":"en","className":"font-en relative rounded-[10px] bg-gray-100 px-[0.3rem] py-[0.2rem] font-mono text-sm font-semibold text-pink-600","children":"on"}]," 대신 ",["$","code",null,{"lang":"en","className":"font-en relative rounded-[10px] bg-gray-100 px-[0.3rem] py-[0.2rem] font-mono text-sm font-semibold text-pink-600","children":"in"}],"을 써야 할지 헷갈리는 순간이 오죠. 특히 시간, 장소, 이동을 나타내는 전치사들은 그 쓰임이 너무 비슷해서 영어 원어민들도 가끔 농담 삼아 '가장 어려운 부분'이라고 말할 정도입니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["하지만 걱정하지 마세요! 전치사는 ",["$","strong","strong-0",{"children":"'큰 범위에서 작은 범위로 좁혀가는 깔때기'"}]," 개념만 이해하면 훨씬 쉽게 접근할 수 있습니다. 오늘은 전치사 하나 때문에 발생한 교훈적인 문화적 오해 스토리와 함께, YES 수업에서 바로 써먹을 수 있는 시간, 장소, 이동의 전치사 핵심 규칙을 완벽하게 정리해 드리겠습니다."]}],"\n",["$","hr","hr-0",{}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"전치사 하나가 만든 아찔한 문화적 오해 스토리"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L4",null,{"src":"/images/blog/2025-12-23-prepositions-time-place-movement-1-h2-1.jpg","alt":"전치사 하나가 만든 아찔한 문화적 오해 스토리","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"전치사 하나가 만든 아찔한 문화적 오해 스토리"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"몇 년 전, YES를 통해 유학 생활을 준비하던 민지 씨의 이야기입니다. 민지 씨는 미국인 친구 사라와 주말 약속을 잡는 과정에서 작은 실수를 저질렀습니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"사라는 민지 씨에게 \"우리 토요일에 만나서 점심 먹자. 어디에서 만날까?\"라고 물었습니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"민지 씨는 한국식 사고방식으로 '어떤 건물 안'이라는 넓은 공간을 염두에 두고 이렇게 답했습니다."}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["❌ Minji: \"Let's meet ",["$","strong","strong-0",{"children":"in"}]," the Starbucks at 2 PM.\" (2시에 스타벅스에서 만나자.)"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["겉으로 보기엔 문제가 없어 보입니다. 하지만 이 말을 들은 사라는 약간 당황했습니다. 미국 문화에서 'in the Starbucks'는 스타벅스 ",["$","em","em-0",{"children":"건물 내부"}],"라는 넓은 공간 전체를 의미할 뿐, '만남의 지점'을 특정해주지 않기 때문입니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"결국 사라가 2시에 스타벅스에 도착해서 민지 씨에게 전화를 걸었습니다."}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["📞 Sarah: \"Hey, I'm here. Where are you ",["$","strong","strong-0",{"children":"in"}]," the cafe?\"\r\n📞 Minji: \"I'm right ",["$","strong","strong-1",{"children":"at"}]," the window seat.\""]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["사라는 민지 씨가 처음에 ",["$","code",null,{"lang":"en","className":"font-en relative rounded-[10px] bg-gray-100 px-[0.3rem] py-[0.2rem] font-mono text-sm font-semibold text-pink-600","children":"in"}],"이라고 했을 때, 막연히 \"스타벅스라는 공간\"에 있다는 말만 들었기 때문에, ",["$","strong","strong-0",{"children":"'정확히 어디에서 기다려야 할지'"}]," 알지 못했습니다. 만약 민지 씨가 처음부터 정확한 지점을 나타내는 ",["$","strong","strong-1",{"children":["$","co