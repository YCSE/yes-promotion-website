className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["The train is scheduled to depart ",["$","strong","strong-0",{"children":"at"}]," 6:00 AM sharp. (기차는 오전 6시 정각에 출발할 예정입니다.)"]}],"\n"]}],"\n"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"관용적 표현:"}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["I usually read a book ",["$","strong","strong-0",{"children":"at"}]," night. (저는 보통 밤에 책을 읽습니다.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["Let's grab a quick lunch ",["$","strong","strong-0",{"children":"at"}]," noon. (정오에 간단하게 점심을 먹읍시다.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["We heard fireworks exploding ",["$","strong","strong-0",{"children":"at"}]," midnight. (우리는 자정에 폭죽이 터지는 소리를 들었습니다.)"]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","hr","hr-2",{}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"이동 방향을 나타내는 전치사"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L4",null,{"src":"/images/blog/2025-12-23-prepositions-time-place-movement-1-h2-4.jpg","alt":"이동 방향을 나타내는 전치사","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"이동 방향을 나타내는 전치사"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"장소와 시간 전치사를 정리했다면, 이제 이동과 방향을 나타내는 전치사도 살펴봐야 합니다. 이 전치사들은 특히 동사(V