appy -> ",["$","strong","strong-0",{"children":"happier"}]," (더 행복한)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["easy -> ",["$","strong","strong-0",{"children":"easier"}]," (더 쉬운)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["busy -> ",["$","strong","strong-0",{"children":"busier"}]," (더 바쁜)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["예문: \"She looks much ",["$","strong","strong-0",{"children":"happier"}]," after her vacation.\" (그녀는 휴가 후에 훨씬 더 행복해 보여요.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["예문: \"Learning English is getting ",["$","strong","strong-0",{"children":"easier"}]," for me now.\" (이제 영어를 배우는 것이 저에게 더 쉬워지고 있어요.)"]}],"\n"]}],"\n"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","strong","strong-0",{"children":"단모음 + 단자음으로 끝나는 단어는 마지막 자음을 한 번 더 쓰고 -er:"}]}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["big -> ",["$","strong","strong-0",{"children":"bigger"}]," (더 큰)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["hot -> ",["$","strong","strong-0",{"children":"hotter"}]," (더 뜨거운)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["thin -> ",["$","strong","strong-0",{"children":"thinner"}]," (더 얇은/마른)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["예문: \"My new apartment is ",["$","strong","strong-0",{"children":"bigger"}]," than my old one.\" (새 아파트는 제 옛 아파트보다 더 커요.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["예문: \"The weather today is ",["$","strong","strong-0",{"children":"hotter"}]," than yesterday.\" (오늘 날씨는 어제보다 더 덥습니다.)"]}],"\n"]}],"\n"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"more를 붙이는 경우:"}]," 세 음절 이상의 형용사/부사 또는 일부 두 음절 단어"]}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["beautiful -> ",["$","strong","strong-0",{"children":"more beautiful"}]," (더 아름다운)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["difficult -> ",["$","strong","strong-0",{"children":"more difficult"}]," (더 어려운)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["expensive -> ",["$","strong","strong-0",{"children":"more expensive"}]," (더 비싼)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["important -> ",["$","strong","strong-0",{"children":"more important"}]," (더 중요한)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["예문: \"This painting is ",["$","strong","strong-0",{"children":"more beautiful"}]," than the one I saw last week.\" (이 그림은 지난주에 본 것보다 더 아름다워요.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["예문: \"Studying for the exam was ",["$","strong","strong-0",{"children":"more difficult"}]," than I expected.\" (시험 공부는 제가 예상했던 것보다 더 어려웠습니다.)"]}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","strong","strong-0",{"children":"2. 불규칙 변화 (불규칙 비교급)"}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"일부 형용사/부사는 위 규칙을 따르지 않고 특별한 형태로 변합니다. 이 단어들은 통째로 외워두어야 합니다."}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":