ll h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"1. 비난 대신 '나(I) 메시지'로 시작하기: 감정 전달의 기술"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"갈등 상황에서 우리가 가장 쉽게 저지르는 실수는 상대방에게 책임을 전가하는 것입니다. \"You are always late\" (당신은 항상 늦어요)와 같은 'You-메시지'는 상대방을 방어적으로 만들고 대화를 단절시킵니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["대신, ",["$","strong","strong-0",{"children":"'I-메시지'"}],"를 사용하여 상황에 대한 나의 느낌과 생각을 전달하는 것이 훨씬 효과적입니다. 'I-메시지'는 다음 세 부분으로 구성됩니다."]}],"\n",["$","ol",null,{"className":"my-6 ml-6 list-decimal [&>li]:mt-2 marker:text-yes-blue marker:font-bold","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"I feel [나의 감정]"}]," (나는 ~을 느낀다)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"when [상대방의 행동/상황]"}]," (~한 상황이 발생했을 때)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"because [이유/영향]"}]," (~하기 때문에)"]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"구체적인 예문 연습"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"직장 동료가 마감 기한을 자주 놓쳐서 내가 야근을 해야 하는 상황이라고 가정해 봅시다."}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n",["$","div",null,{"className":"my-6 w-full overflow-y-auto rounded-[10px] border border-gray-200","children":["$","table",null,{"className":"w-full","children":[["$","thead",null,{"className":"bg-gray-50 border-b border-gray-200","children":["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"피해야 할 표현 (You-Message)"}],["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"사용해야 할 표현 (I-Message)"}]]}]}],["$","tbody",null,{"className":"divide-y divide-gray-100","children":["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":[["$","strong","strong-0",{"children":"You missed the deadline again,"}]," and now I have to stay late. (또 마감 기한을 놓쳤잖아요. 이제 내가 야근해야 하잖아요.)"]}],["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":[["$","strong","strong-0",{"children":"I feel stressed"}]," when the project updates are delayed ",["$","strong","strong-1",{"children":"because"}]," it means I have to cancel my evening commitments to compensate. (프로젝트 업데이트가 지연될 때 ",["$","strong","strong-2",{"children":"저는 스트레스를 느낍니다."}]," 왜냐하면 보충하기 위해 저녁 약속을 취소해야 하기 때문입니다.)"]}]]}]}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"키 포인트:"}]," 'I-메시지'는 상대의 행동 자체를 비난하지 않고, ",["$","strong","strong-1",{"children":"그 행동이 나에게 미치는 영향"}],"에 집중합니다. 이는 대화를 감정 싸움이 아닌 문제 해결 영역으로 끌어올립니다."]}],"\n",["$","hr","hr-1",{}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"2. 문제의 '영향'에 집중하기: 객관적인 결과 설명"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2025-10-23-conflict-resolution-workplace-1-h2-2.jpg","alt":"2. 문제의 '영향'에 집중하기: 객관적인 결과 설명","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"2. 문제의 '영향'에 집중하기: 객관적인 결과 설명"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["감정을 전달하는 데 성공했다면, 다음 단계는 이 문제가 비즈니스 목표나 팀 전체에 미치는 객관적인 영향을 설명하는 것입니다. 관리자나 상대를 설득할 때 감정적인 호소보다 ",["$","strong","strong-0",{"children":"사실과 데이터"}],"가 훨씬 더 큰 힘을 발휘합니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["이때 중요한 것은 상황을 과장하거나 일반화하지 않고, ",["$","strong","strong-0",{"children":"구체적인 사건"}],"과 ",["$","strong","strong-1",{"children":"측정 가능한 결과"}],"에 초점을 맞추는 것입니다."]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"영향 설명에 유용한 표현"}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"This resulted in..."}]," (이것은 ~라는 결과를 낳았습니다.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"The consequence was..."}]," (그 결과는 ~이었습니다.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"We lost [specific metric]..."}]," (우리는 [구체적인 수치]를 잃었습니다...)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"The delivery was postponed by..."}]," (납품이 ~만큼 연기되었습니다.)"]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"구체적인 예문 연습"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"지난주 마케팅 자료 검토가 늦어져 중요한 외부 미팅에서 자료를 사용할 수 없었던 상황입니다."}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["\"When the final draft was submitted only an hour before the client presentation, ",["$","strong","strong-0",{"children":"we couldn't secure the necessary legal review."}]," This resulted in ",["$","strong","strong-1",{"children":"us having to use an older, less effective presentation"}]," which was disappointing.\""]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["(",["$","em","em-0",{"children":"최종 초안이 고객 프리젠테이션 한 시간 전에 제출되었을 때, 우리는 필요한 법적 검토를 확보할 수 없었습니다. 그 결과 우리는 실망스럽게도 이전 버전의 덜 효과적인 프리젠테이션을 사용해야 했습니다."}],")"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"핵심:"}]," ",["$","strong","strong-1",{"children":"\"We couldn't secure the legal review\""}],"처럼, 발생한 객관적인 사실을 명확히 전달하여 개인적인 감정이 아니라 ",["$","strong","strong-2",{"children":"업무적 손실"}],"임을 강조해야 합니다."]}],"\n",["$","hr","hr-2",{}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"3. 협력적인 해결책 요청: 제안의 언어 사용"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2025-10-23-conflict-resolution-workplace-1-h2-3.jpg","alt":"3. 협력적인 해결책 요청: 제안의 언어 사용","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"3. 협력적인 해결책 요청: 제안의 언어 사용"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["문제를 정확히 짚었다면 이제 해결책을 제시할 차례입니다. 갈등 해결 대화의 최종 목표는 관계를 훼손하지 않고 ",["$","strong","strong-0",{"children":"향후 행동 변화"}],"를 이끌어내는 것입니다. 따라서 요청(Request)은 명령(Demand)이 아니라 ",["$","strong","strong-1",{"children":"제안(Suggestion)"}],"의 형태로 이루어져야 합니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"협력적 해결책 요청 시에는 부드러운 언어(Softening Language)를 사용하여 상대방이 제안을 편안하게 받아들일 수 있도록 유도해야 합니다."}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"부드러운 요청을 위한 템플릿"}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",["$","div",null,{"className":"my-6 w-full overflow-y-auto rounded-[10px] border border-gray-200","children":["$","table",null,{"className":"w-full","children":[["$","thead",null,{"className":"bg-gray-50 border-b border-gray-200","children":["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"요청 유형"}],["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"영어 표현"}]]}]}],["$","tbody",null,{"className":"divide-y divide-gray-100","children":[["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":["$","strong","strong-0",{"children":"제안하기"}]}],["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":[["$","strong","strong-0",{"children":"How about we..."}]," (저희가 ~하는 건 어떨까요?)"]}]]}],["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":["$","strong","strong-0",{"children":"의견 묻기"}]}],["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":[["$","strong","strong-0",{"children":"Would you be open to..."}]," (당신은 ~하는 것에 열려 있습니까?)"]}]]}],["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":["$","strong","strong-0",{"children":"가능성 확인"}]}],["$","td",null,{"className":"px-4 py-3 text-gray-700","style":{"textAlign":"left"},"children":[["$","strong","strong-0",{"children":"Perhaps we could try..."}]," (아마도 저희가 ~를 시도해 볼 수 있을 것 같습니다.)"]}]]}]]}]]}]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"구체적인 예문 연습"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"팀원 간 회의 시간이 자꾸 지연되는 문제를 해결하기 위한 요청입니다."}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["\"To make sure we always start our meetings on time, ",["$","strong","strong-0",{"children":"perhaps we could try setting a hard rule of locking the conference room door exactly at 10 AM."}]," This would help us respect everyone's schedule. ",["$","strong","strong-1",{"children":"Would you be open to trying that for the next month?"}],"\""]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["(",["$","em","em-0",{"children":"우리가 항상 회의를 제 시간에 시작할 수 있도록, 오전 10시에 정확히 회의실 문을 잠그는 엄격한 규칙을 시도해 보는 건 어떨까요? 이것이 모두의 일정을 존중하는 데 도움이 될 것입니다. 다음 달 동안 이것을 시도하는 것에 동의하십니까?"}],")"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"팁:"}]," 질문 형식으로 끝맺으면(Would you be open to...?), 상대방이 대화에 참여하고 자신의 의견을 제시할 여지를 주어 협력적인 분위기를 조성할 수 있습니다."]}],"\n",["$","hr","hr-3",{}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"4. 건설적인 반론 처리: 이해를 표현하며 대화 이어가기"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["$","span",null,{"className":"block my-8","children":[["$","$L3",null,{"src":"/images/blog/2025-10-23-conflict-resolution-workplace-1-h2-4.jpg","alt":"4. 건설적인 반론 처리: 이해를 표현하며 대화 이어가기","width":900,"height":500,"className":"rounded-[10px] border border-gray-100 w-full h-auto shadow-none"}],["$","span",null,{"className":"block text-center text-sm text-gray-500 mt-2 italic","children":"4. 건설적인 반론 처리: 이해를 표현하며 대화 이어가기"}]]}]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["갈등 해결 과정이 항상 순조롭지는 않습니다. 상대방이 변명하거나, 당신의 주장에 반박할 수 있습니다. 이때 감정적으로 반응하거나 상대의 방어를 무시해서는 안 됩니다. 전문적인 대화에서는 ",["$","strong","strong-0",{"children":"상대방의 관점을 인정하는 것(Acknowledge)"}],"이 대화를 계속 이어갈 수 있는 핵심입니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"반론을 처리할 때는 '인정(Acknowledge) + 재확인(Reaffirm)'의 구조를 사용하세요."}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"반론 처리 유용한 표현"}],"\n",["$","ul",null,{"className":"my-6 ml-6 list-disc [&>li]:mt-2 marker:text-yes-blue","children":["\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"I appreciate you sharing your perspective."}]," (당신의 관점을 공유해 주셔서 감사합니다.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"I understand that is a challenge."}]," (그것이 어려운 일이라는 것을 이해합니다.)"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":[["$","strong","strong-0",{"children":"That’s a fair point, however..."}]," (그것은 합리적인 지적입니다만, 그럼에도 불구하고...)"]}],"\n"]}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"구체적인 예문 연습"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"직원이 \"보고서 마감 시간을 앞당길 수 없는 것은 다른 프로젝트가 너무 많기 때문\"이라고 반박하는 상황입니다."}],"\n",["$","blockquote",null,{"className":"mt-6 border-l-4 border-yes-blue pl-6 italic text-gray-700 bg-gray-50 py-4 pr-4 rounded-r-[10px]","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"Employee:"}]," \"I can’t submit the reports earlier. My workload is too heavy with Project Alpha.\""]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"You (Coach Aiden):"}]," \"",["$","strong","strong-1",{"children":"I appreciate that you are dealing with a heavy workload."}]," And I understand Project Alpha requires a lot of your time. ",["$","strong","strong-2",{"children":"However,"}]," the delay in your weekly report is directly affecting the client presentation deadline next Tuesday. ",["$","strong","strong-3",{"children":"Could you help me understand"}]," if there is any way we can delegate some of your smaller tasks temporarily?\""]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["(",["$","em","em-0",{"children":"'당신이 많은 업무량으로 고생하고 있다는 점 감사합니다.' 그리고 프로젝트 알파에 많은 시간이 필요하다는 것을 이해합니다. 하지만, 주간 보고서 지연이 다음 주 화요일 고객 프리젠테이션 마감일에 직접적인 영향을 미치고 있습니다. 우리가 일시적으로 당신의 작은 업무 중 일부를 위임할 방법이 있는지 '제가 이해할 수 있도록 도와주시겠어요?'"}],")"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"마무리:"}]," \"Help me understand\"나 \"Could you clarify?\"와 같은 표현은 상대방을 심문하는 것이 아니라, 함께 문제의 근본 원인을 찾으려는 협력적인 태도를 보여줍니다."]}],"\n",["$","hr","hr-4",{}],"\n",["$","h2",null,{"className":"scroll-m-20 border-b border-gray-100 pb-2 text-3xl font-bold tracking-tight first:mt-0 mt-12 mb-6 text-gray-900","children":"결론: 품격 있는 영어는 결국 협력의 언어입니다"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":["직장 내 갈등을 영어로 해결하는 것은 단순히 문법이나 어휘의 문제가 아닙니다. 그것은 바로 ",["$","strong","strong-0",{"children":"공감 능력과 전문성을 동시에 보여주는 대화의 기술"}],"입니다."]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"오늘 배운 'I-메시지', 영향 집중, 부드러운 요청, 그리고 건설적인 반론 처리 4단계는 어떤 상황에서도 당신이 감정을 통제하고 문제 해결에 집중할 수 있도록 도와줄 것입니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"YES 화상영어 수업 시간에 코치님과 함께 오늘 배운 표현들을 실제 역할극(Role-playing)으로 연습해 보세요. 반복적인 훈련만이 당신을 품격 있는 갈등 해결 전문가로 만들어 줄 것입니다."}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"다음에도 직장 영어를 업그레이드할 수 있는 유익한 내용으로 돌아오겠습니다!"}]]}]}]}],["$","$L4",null,{"posts":[{"slug":"2025-10-02-passive-voice-academic-writing-1","title":"학술 영작문 스킬업! 수동태 마스터로 연구의 품격을 높이는 방법","subtitle":"YES 학생을 위한 학술 영작문 게임: 수동태 활용법 완전 정복!","date":"$D2025-10-02T02:18:34.471Z","featuredImage":"/images/blog/2025-10-02-passive-voice-academic-writing-1.jpg","excerpt":"학술 영작문에서 수동태는 객관성과 명확성을 높이는 중요한 도구입니다. YES 학생들을 위해 게임처럼 즐겁게 수동태를 마스터하는 전략과 팁을 소개합니다."},{"slug":"2026-04-16-academic-vocabulary-university-1","title":"대학 성공을 결정짓는 학술 어휘를 스포츠 선수의 훈련법으로 마스터하기","subtitle":"기초 체력부터 실전 기술까지 완벽하게 준비하는 학술 영어 공부의 정석","date":"$D2026-04-16T04:13:05.858Z","featuredImage":"/images/blog/2026-04-16-academic-vocabulary-university-1.jpg","excerpt":"대학 생활에서 마주하는 높은 영어의 벽을 스포츠 코칭 멘탈리티로 극복하는 구체적인 방법을 제안합니다. 학술 어휘를 단순 암기가 아닌 실전 기술로 익혀 학업 성취도를 높이는 전략을 확인해보세요."},{"slug":"2026-02-23-comparative-superlative-forms-1","title":"영어 실력을 한 단계 높여주는 비교급과 최상급 완벽 마스터 가이드","subtitle":"YES 화상영어와 함께 떠나는 비교와 최상 표현의 집중 학습 부트캠프","date":"$D2026-02-23T03:38:20.187Z","featuredImage":"/images/blog/2026-02-23-comparative-superlative-forms-1.jpg","excerpt":"영어 회화에서 가장 자주 쓰이는 비교급과 최상급의 핵심 규칙을 정리했습니다. 단순한 문법 암기를 넘어 실제 상황에서 바로 사용할 수 있는 구체적인 예문과 변형 규칙을 지금 바로 확인해 보세요."}]}]]}]],null],null],null]},[[null,[["$","$L5",null,{"id":"article-structured-data-2025-10-23-conflict-resolution-workplace-1","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"{{title}}\",\"description\":\"{{description}}\",\"image\":\"{{image}}\",\"datePublished\":\"{{datePublished}}\",\"dateModified\":\"{{dateModified}}\",\"author\":{\"@type\":\"Organization\",\"name\":\"YES 화상영어\",\"url\":\"https://yourenglishschool.co.kr\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"YES 화상영어\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://yourenglishschool.co.kr/ogimage.jpg\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://yourenglishschool.co.kr/blog/2025-10-23-conflict-resolution-workplace-1\"}}"},"strategy":"afterInteractive"}],["$","$L5",null,{"id":"breadcrumb-structured-data-2025-10-23-conflict-resolution-workplace-1","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"홈\",\"item\":\"https://yourenglishschool.co.kr\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"블로그\",\"item\":\"https://yourenglishschool.co.kr/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"{{title}}\",\"item\":\"https://yourenglishschool.co.kr/blog/2025-10-23-conflict-resolution-workplace-1\"}]}"},"strategy":"afterInteractive"}],["$","$L6",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","$7","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L8",null,{}],"templateStyles":"$undefined","temp