e":"text-gray-700 leading-7 pl-2","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"BE:"}]," \"We ",["$","strong","strong-1",{"children":"haven't eaten"}]," lunch yet, so we are starving.\" (현재까지 점심을 먹지 못했음)"]}],"\n"]}],"\n",["$","li",null,{"className":"text-gray-700 leading-7 pl-2","children":["\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":[["$","strong","strong-0",{"children":"AE:"}]," \"We ",["$","strong","strong-1",{"children":"didn't eat"}]," lunch yet, so we are starving.\" (일상 구어체에서 더 흔함)"]}],"\n"]}],"\n"]}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"두 문장 모두 의미 전달은 되지만, 해당 원어민에게 더 자연스럽게 들리는 방식이 있다는 것을 아는 것이 중요합니다. 특히 YES 수업에서 배운 현재 완료 구문을 'just'와 함께 사용했는데 미국인 강사가 과거형으로 고쳐준다면, 이것은 문법적 오류가 아니라 스타일 차이일 수 있습니다."}],"\n",["$","h3",null,{"className":"scroll-m-20 text-2xl font-bold tracking-tight mt-10 mb-4 text-yes-blue","children":"2. 전치사 사용의 차이"}],"\n",["$","p",null,{"className":"leading-8 [&:not(:first-child)]:mt-6 text-gray-700 font-light text-lg","children":"특정 명사나 동사 뒤에 붙는 전치사(Prepositions) 또한 다릅니다."}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",["$","div",null,{"className":"my-6 w-full overflow-y-auto rounded-[10px] border border-gray-200","children":["$","table",null,{"className":"w-full","children":[["$","thead",null,{"className":"bg-gray-50 border-b border-gray-200","children":["$","tr",null,{"className":"hover:bg-gray-50/50 transition-colors","children":[["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"의미"}],["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":{"textAlign":"left"},"children":"영국 영어 (BE)"}],["$","th",null,{"className":"px-4 py-3 text-left font-semibold text-gray-900","style":